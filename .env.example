# ===== 服务基础配置 =====
PORT=8787
# SQLite 数据库文件；:memory: 表示纯内存（重启即丢失）
DATABASE_URL=./data/memory.db

# ===== 上游模型（MultiCA / OpenAI 兼容端点）=====
# 留空即自动启用内置 Mock 上游；真实联调时填写，例如 https://multica.example.com
MULTICA_BASE_URL=
MULTICA_API_KEY=
# 客户端未传 model 时使用的默认模型名
DEFAULT_MODEL=mock-gpt
# 显式开启内置 Mock 上游（MULTICA_BASE_URL 为空时也会自动开启）
MOCK_UPSTREAM=true
# 上游请求超时（毫秒）
UPSTREAM_TIMEOUT_MS=30000

# ===== 记忆能力 =====
MEMORY_ENABLED=true
MEMORY_AUTO_EXTRACT=true
MEMORY_MAX_ITEMS=5
# 按字符粗估（1 token ≈ 4 字符），超过预算即停止注入更多记忆
MEMORY_TOKEN_BUDGET=800
# 低于该置信度的候选标记为 low_confidence，且绝不自动写入正式记忆
EXTRACT_MIN_CONFIDENCE=0.6

# ===== 身份映射 =====
# JSON：API Key -> { user_id, agent_id }。留空则使用下方内置开发 Key（见 README）
# 例：{"my-key":{"user_id":"u1","agent_id":"developer"}}
API_KEYS=
# 未提供 / 未识别 API Key 时的兜底身份
DEFAULT_USER_ID=u1
DEFAULT_AGENT_ID=developer

# ===== 日志 =====
# 设为 true 时关闭运行日志（测试环境使用）
LOG_SILENT=false

# ===== 知忆 · 运行期模型服务设置 =====
# 设置页（GET /settings）保存的配置文件；权限 600，data/ 已在 .gitignore 中
ZHIYI_SETTINGS_PATH=./data/model-settings.json
# 设置接口管理令牌。留空 = 仅允许本机 127.0.0.1 访问；设置后远程访问需 Bearer 令牌
ZHIYI_SETTINGS_TOKEN=
