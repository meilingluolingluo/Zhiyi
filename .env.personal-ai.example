# ===== Personal AI Runtime（独立于 .env.example 的 16 个基础变量）=====
# 复制为 .env.personal-ai 后由 scripts/start.sh 或 server.ts 自动加载。
# 说明：基础 .env 里的 MULTICA_BASE_URL 实际是「模型代理上游地址」，
#       与 MultiCA CLI 无关；CLI 相关配置全部在下面 MULTICA_* 段。

PERSONAL_AI_ENABLED=true
# openai  = 标准 OpenAI Chat Completions SSE（ADP OpenAICompatible vendor 真实链路，默认）
# adp-v2 = 按 ADP 源码 EventType 枚举直出 V2 SSE（供直连/扩展验证）
PERSONAL_AI_PROTOCOL=openai

# ===== 可信身份 =====
# 留空 = 本地 PoC 模式（只按 API Key 映射身份，不校验签名）。
# 配置后强制校验 X-PersonalAI-Timestamp + X-PersonalAI-Signature（HMAC-SHA256）。
PERSONAL_AI_SHARED_SECRET=
PERSONAL_AI_SIGNATURE_MAX_AGE_MS=300000
# JSON: API Key -> { user_id, agent_id }；留空沿用 DEFAULT_API_KEYS
# 例：{"adp-server-key":{"user_id":"u1","agent_id":"developer"}}
PERSONAL_AI_API_KEYS=

# ===== 执行策略 =====
# SSE 最长保持时间（毫秒）；超时后提示用户通过任务接口查询，后台任务继续执行
PERSONAL_AI_STREAM_MAX_MS=120000
# 命中这些关键词且包含动作诉求时委派 Agent（JSON 数组或逗号分隔）
PERSONAL_AI_AGENT_KEYWORDS=

# 可选：ADP Chat Client 的健康检查地址（容器内不要用 localhost 指向宿主机）
PERSONAL_AI_ADP_HEALTH_URL=

# 可选：覆盖基础 .env 中的模型上游地址/密钥（避免重复维护时用这一组）
MODEL_BASE_URL=
MODEL_API_KEY=

# ===== MultiCA CLI（Agent 执行平台）=====
# 默认关闭；真实联调前需完成 `multica setup` 并启动 daemon。
MULTICA_ENABLED=false
# 默认通过 PATH 查找；容器内需指向可执行文件或挂载的宿主机路径
MULTICA_CLI_PATH=multica
MULTICA_WORKSPACE=
MULTICA_CLI_CWD=
MULTICA_DAEMON_REQUIRED=true
MULTICA_POLL_INTERVAL_MS=3000
MULTICA_COMMAND_TIMEOUT_MS=30000
MULTICA_MAX_CONCURRENT_TASKS=3
MULTICA_MAX_POLLS=200
# 创建 issue 时通过 --assignee 指定的 Agent 名；留空则由 MultiCA 默认分配
MULTICA_DEFAULT_AGENT=

# ===== 以下变量仅测试/冒烟使用，不属于 src/personal-ai/config.ts 的读取项，不要在生产设置 =====
# MULTICA_STUB_STATE       scripts/mock-multica-cli.mjs 的状态文件路径（默认 ./data/multica-stub-state.json）
# MULTICA_STUB_SLEEP_MS    让 stub 每次调用先延迟 N 毫秒（用于超时/并发测试）
# MULTICA_STUB_STUCK=1     让 stub 的 `issue runs` 永远返回 queued（用于取消/降级测试）

# ===== 真实环境（macOS 本机，无 Docker）推荐值 =====
# 完整步骤见 docs/LOCAL-DEPLOYMENT.md；验证结果见 docs/LOCAL-E2E-REPORT.md。
#
# 端口约定（.env 里的 PORT 建议设为 8790；8787 常被本机模型代理占用）：
#   Gateway        8790
#   ADP 后端        8000
#   ADP 前端        5174
#   PostgreSQL     5433（embedded-postgres，数据在 data/pgdata）
#
# 真实模型：把 .env 的 MULTICA_BASE_URL / MULTICA_API_KEY / DEFAULT_MODEL 指向真实端点，
# 并设置 MOCK_UPSTREAM=false。下面两项可覆盖同名模型配置（与 MultiCA CLI 无关）：
# MODEL_BASE_URL=http://127.0.0.1:8787/v1
# MODEL_API_KEY=
#
# MultiCA 真实执行：需先完成浏览器 OAuth 与 daemon 启动，再改这一组：
#   multica setup cloud      # 打开浏览器登录（自动化环境无法代替）
#   multica daemon start
# MULTICA_ENABLED=true
# MULTICA_CLI_PATH=multica
# MULTICA_DEFAULT_AGENT=Codex
#
# 注意：PERSONAL_AI_SHARED_SECRET 留空 = 本地 PoC（只按 API Key 映射身份）；
# ADP 与 Gateway 在同一台机器时可留空，公网/多机部署必须配置。
