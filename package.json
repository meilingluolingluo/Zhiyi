{
  "name": "universal-memory-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "通用 AI 记忆网关 MVP：让 Codex / Claude Code / DeepSeek 等 Agent 共享同一份用户长期记忆",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run --reporter=verbose",
    "smoke": "node scripts/smoke-personal-ai.mjs",
    "db:init": "tsx scripts/db-init.ts",
    "candidates": "tsx scripts/candidates.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
